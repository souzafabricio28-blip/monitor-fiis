# Copie para .env e preencha (nunca commite o .env)
APP_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
SQLITE_PATH=fii_data.db

# Login do dashboard (obrigatório em produção / Render / Neon)
AUTH_USER=seu_usuario
AUTH_PASSWORD=troque-esta-senha-forte-com-12-caracteres-ou-mais
AUTH_PASSWORD_ALT=

# Recuperação de senha por e-mail (login -> "Esqueci minha senha")
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=senha-de-app-do-gmail
RECOVERY_EMAIL=seu_email@gmail.com

# GitHub (push no master / Render). Preencha no .env, nunca no Git.
GH_TOKEN=

# Render — Deploy Hook (Settings do serviço → Deploy Hook). Preferir isto
# para "subir" o site sem API key completa.
RENDER_DEPLOY_HOOK=

# Publicar no Render (python publicar_render.py) — opcional se o hook existir
# RENDER_API_KEY=rnd_sua_chave_aqui

# Opcional — Telegram (preferir env em vez de salvar no banco)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
